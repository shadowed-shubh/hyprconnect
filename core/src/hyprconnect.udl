namespace hyprconnect_core {
    [Throws=HyprConnectError]
    void set_config_dir(string path);

    [Throws=HyprConnectError, Async]
    void pair(string device_id);

    [Throws=HyprConnectError, Async]
    void start_discovery(string device_name, string device_type, boolean auto_pair);

    sequence<DeviceInfo> list_devices();

    [Throws=HyprConnectError]
    void remove_trusted_device(string device_id);

    void register_callback(DeviceEventCallback callback);
    void confirm_pairing(string device_id, boolean accepted);
};

dictionary DeviceInfo {
    string device_id;
    string device_name;
    string device_type;
    boolean trusted;
    boolean online;
};

[Error]
enum HyprConnectError {
    "DeviceNotFound",
    "PairingInProgress",
    "InvalidSettings",
    "Transport",
};

callback interface DeviceEventCallback {
    void on_pairing_code(string device_id, string code);
};
